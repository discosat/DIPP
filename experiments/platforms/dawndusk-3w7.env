# Energy-deficit sensitivity platform (2026-10-14; not DISCO-2): DISCO-2's
# battery, platform load and orbit period, but a dawn-dusk orbit in continuous
# sunlight with only 3.7 W left for the payload, and the board always on.
# Low effort is then sustainable and high effort is not; the board grid's
# block D runs here from 0.05 Wh above the floor (paper-rev, board grid plan).
DIPP_BATT_CAPACITY_WH=92
DIPP_BATT_BUS_W=13.07
DIPP_BATT_ORBIT_MIN=95.43
DIPP_BATT_PROFILE=dawndusk_3w7.profile
DIPP_BATT_BOARD_MODE=always
DIPP_BATT_BOARD_IDLE_W=3.30
DIPP_BATT_BOARD_HOLD_S=60
DIPP_BATT_SURVIVAL_ORBITS=2

# Stated orbit-average power available to the payload, generation - bus:
# 16.77 W - 13.07 W. Required with DIPP_SCHED_ENERGY on.
DIPP_SCHED_POWER_BUDGET_MW=3700
