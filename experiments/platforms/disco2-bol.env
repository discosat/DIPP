# DISCO-II, beginning of life. Sourced by run.sh --platform; every line is
# required by the battery simulator (src/include/battery_simulator.h), which
# refuses to start without it. Sources: SI-DISCOII-DR-001 Issue 1.0
# (2023-03-29) and analysis/power-profile/README.md.
#
# Run-specific initial conditions are NOT here: run.sh --soc0 --phase0.

# BAT100-P4, §5.1.3
DIPP_BATT_CAPACITY_WH=92
# Table 6 total. Includes the cameras (1.03 W); excludes the processing board.
DIPP_BATT_BUS_W=13.07
# Mean motion 15.09 rev/day, §7.2.1: 1440 / 15.09
DIPP_BATT_ORBIT_MIN=95.43
# Fig 7-3 digitised, at the report's 17.3 W panel average, x 0.95 power point
# tracker efficiency (§5.1.2) = 16.435 W delivered.
DIPP_BATT_PROFILE=disco2_fig7-3_bol.profile

# The processing board (our i.MX 8M Plus), not the satellite. Idle: top of the
# Otii-measured post-boot floor (3.03-3.30 W); a board powered per burst is
# always within that window of its boot. Hold: a policy, stated as such.
DIPP_BATT_BOARD_MODE=burst
DIPP_BATT_BOARD_IDLE_W=3.30
DIPP_BATT_BOARD_HOLD_S=60

# Payload margin, derived (decided 2026-10-03): the payload may never take the
# battery below what the platform alone needs to ride out N orbits with no
# generation at all (tumbling, safe mode): N x 13.07 W x 95.43 min. N = 2:
# 41.6 Wh (45 % of 92 Wh). N is the one policy choice; the rest is the
# platform's. (Replaces one orbit's surplus below full + 2 %, 88.5 Wh, which
# sat above the battery's own post-eclipse level.)
DIPP_BATT_SURVIVAL_ORBITS=2

# Stated orbit-average power available to the payload, generation - bus
# (16.435 W delivered BOL - 13.07 W, analysis/power-profile/README.md). The
# scheduler's energy-timed check uses it until one orbit of battery history
# exists, then the learned value (sched_policy.h). Required with DIPP_SCHED_ENERGY on.
DIPP_SCHED_POWER_BUDGET_MW=3365
